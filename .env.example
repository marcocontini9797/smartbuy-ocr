# Backend Configuration
OPENAI_API_KEY=sk-...your-openai-key...

# Supabase
SUPABASE_URL=https://your-project.supabase.co

# Preferred low-privilege key for user-scoped and anonymous RLS-aware clients.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy low-privilege fallback during migration.
SUPABASE_ANON_KEY=your-legacy-anon-key

# Preferred privileged backend-only key. Never expose this to smartbuy-web
# or any browser/client bundle.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy privileged fallback during migration.
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Backend API URL
BACKEND_API_URL=http://localhost:8000

# Render deployment (set these in Render dashboard, not here)
# PORT=8000 (auto-set by Render)

# OCR multipagina
OPENAI_VISION_MODEL=gpt-4o
OCR_MAX_PAGES=50
OCR_CONCURRENCY=3
OCR_MAX_IMAGE_SIDE=2400
OCR_TIMEOUT_SECONDS=120
# POPPLER_PATH=percorso/alla/cartella/bin

# Openapi Catasto
OPENAPI_CATASTO_SANDBOX_TOKEN=your-openapi-sandbox-token
OPENAPI_CATASTO_SANDBOX=true
OPENAPI_CATASTO_TOKEN=your-openapi-production-token
OPENAPI_RICHIEDENTE_CF=
