# Backend Configuration
OPENAI_API_KEY=sk-...your-openai-key...

# Supabase Configuration (for local development)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend API URL
BACKEND_API_URL=http://localhost:8000

# Render deployment (set these in Render dashboard, not here)
# PORT=8000 (auto-set by Render)
# OCR multipagina (lettura completa, nessun taglio silenzioso)
OPENAI_VISION_MODEL=gpt-4o
OCR_MAX_PAGES=50
OCR_CONCURRENCY=3
OCR_MAX_IMAGE_SIDE=2400
OCR_TIMEOUT_SECONDS=120
# POPPLER_PATH=percorso/alla/cartella/bin (opzionale se Poppler e nel PATH)


# Openapi Catasto (Sandbox is the safe default for local development)
OPENAPI_CATASTO_SANDBOX_TOKEN=your-openapi-sandbox-token
OPENAPI_CATASTO_SANDBOX=true
OPENAPI_CATASTO_TOKEN=your-openapi-production-token
# Needed only for some mortgage-inspection requests; leave empty for Prospetto tests.
OPENAPI_RICHIEDENTE_CF=
