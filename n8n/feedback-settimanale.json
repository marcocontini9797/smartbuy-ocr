{
  "name": "SmartBuy - riepilogo feedback agente",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "name": "Ogni lunedì alle 8",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SMARTBUY_API_URL }}/ops/feedback/negative",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-SmartBuy-Ops-Token",
              "value": "={{ $env.SMARTBUY_OPS_SECRET }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "7"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "name": "Risposte segnate come sbagliate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Ce ne sono?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.items || [];\nconst lines = items.map((f, i) => {\n  const fonti = (f.sources || []).map(s => s.document + (s.page ? ' p.' + s.page : '')).join(', ') || 'nessuna';\n  return `${i + 1}) Domanda: ${f.question}\n   Risposta: ${String(f.answer).slice(0, 400)}\n   Fonti: ${fonti}\n   Commento: ${f.comment || '-'}${f.grounded === false ? '\n   (l'agente aveva dichiarato di non aver trovato l'informazione)' : ''}`;\n});\nreturn [{ json: { count: items.length, text: lines.join('\n\n') } }];"
      },
      "name": "Prepara riepilogo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ]
    },
    {
      "parameters": {
        "fromEmail": "smartbuy@example.com",
        "toEmail": "CAMBIA@example.com",
        "subject": "=SmartBuy: {{ $json.count }} risposte dell'agente da rivedere",
        "emailFormat": "text",
        "text": "={{ $json.text }}"
      },
      "name": "Invia riepilogo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        120
      ]
    }
  ],
  "connections": {
    "Ogni lunedì alle 8": {
      "main": [
        [
          {
            "node": "Risposte segnate come sbagliate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Risposte segnate come sbagliate": {
      "main": [
        [
          {
            "node": "Ce ne sono?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ce ne sono?": {
      "main": [
        [
          {
            "node": "Prepara riepilogo",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Prepara riepilogo": {
      "main": [
        [
          {
            "node": "Invia riepilogo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}